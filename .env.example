# PostgreSQL Database
# Local: postgresql://postgres:postgres@localhost:5432/qr2pic
# Production: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/qr2pic
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/qr2pic

# PostgreSQL Password (for docker-compose)
POSTGRES_PASSWORD=postgres

# Local File Storage
STORAGE_PATH=/app/uploads
STORAGE_URL=http://localhost:3000/images

# Application Configuration
SERVER_PORT=3000
DELETE_KEY=[GENERATE_A_RANDOM_32_CHAR_SECRET]

# Optional: Logging Configuration
RUST_LOG=info
